#!/usr/bin/env bash
# sgctl - securegate admin tool (run on the server, in the repository folder).
#
#   ./sgctl wg add <name> [--via <host>]    add a WireGuard client, show its config + QR code
#   ./sgctl wg show <name> [--via <host>]   show config + QR code again
#   ./sgctl wg conf <name> [--via <host>]   print only the config (> name.conf)
#   ./sgctl wg list                         clients, addresses, last handshake, traffic
#   ./sgctl wg remove <name>                delete a client
#   ./sgctl wg uplink [import <file>]       WG_MODE=uplink (proxy-only server): tunnel status /
#                                           install the client config made on the main server
#                                           (+ WG_UPLINK_RELAY=true: relays clients of the main)
#   ./sgctl mtproxy [user]                  MTProxy links (all implementations / domains)
#   ./sgctl mtproxy qr <user> [impl] [host] QR code of a tg:// link
#   ./sgctl vpn add <name> [--via <host>]   masquerading-VPN user: config + QR for the app
#   ./sgctl vpn show <name> [--via <host>]  show config + QR again
#   ./sgctl vpn conf <name> [--via <host>]  print only the config (> name.sgvpn)
#   ./sgctl vpn list | remove <name>        VPN users: list / delete
#   ./sgctl bans | unban <ip|all>           protection: list / remove bans
#   ./sgctl status                          containers and ports
#
#   ./sgctl up                              build + start (= docker compose up -d --build)
#   ./sgctl ps | logs [service] | restart [service] | down | build
#   ./sgctl compose <args...>               any compose command
# Works with the compose plugin (docker compose) and the standalone docker-compose v2 binary.
# The old docker-compose v1 (python, 1.x) is refused: with current Docker (containerd image
# store) it fails to re-create containers on updates and leaves services stopped.
# On a proxy server docker-compose.proxy.yml is used (SGCTL_COMPOSE_FILE overrides).
#
# --via <host>: endpoint in the WireGuard config. Default is DOMAIN; use the domain of a proxy
# instance (PROXY_FRONTENDS) to give the client a config that connects through that proxy.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

env_val() { # value of KEY from .env (last assignment wins, quotes stripped); empty if absent
  [ -f .env ] || return 0
  # `|| true`: a missing key makes grep exit non-zero and, with `set -o pipefail`, would otherwise
  # abort the caller's `x=$(env_val ...)` under `set -e`.
  { grep -E "^[[:space:]]*$1=" .env | tail -n1 | cut -d= -f2- | sed -e "s/^['\"]//" -e "s/['\"][[:space:]]*$//"; } || true
}
is_proxy() { case "$(env_val PROXY | tr 'A-Z' 'a-z')" in 1|true|yes|on) return 0;; esac; return 1; }

# Containers are addressed by name with plain `docker exec`, so sgctl works with both the
# compose plugin (docker compose) and the standalone docker-compose binary.
running() { docker ps --format '{{.Names}}' | grep -qx "$1"; }

# ---- compose wrapper -------------------------------------------------------------------------
compose_file() {
  if [ -n "${SGCTL_COMPOSE_FILE:-}" ]; then echo "$SGCTL_COMPOSE_FILE"
  elif [ -f docker-compose.proxy.yml ] && { running securegate-proxy || { is_proxy && ! running securegate-gateway; }; }; then
    echo docker-compose.proxy.yml
  else echo docker-compose.yml; fi
}
compose() {
  local f ver
  f=$(compose_file)
  if docker compose version >/dev/null 2>&1; then
    docker compose -f "$f" "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    ver=$(docker-compose version --short 2>/dev/null || true)
    case "$ver" in
      1.*)
        cat >&2 <<MSG
docker-compose $ver (v1) is too old: with current Docker it breaks container updates.
Install Compose v2 (keeps all data, containers and .env):
  Ubuntu/Debian packages:      apt install docker-compose-v2
  Docker's own apt repository: apt install docker-compose-plugin
then run ./sgctl up again (or: docker compose up -d --build).
MSG
        exit 1 ;;
    esac
    docker-compose -f "$f" "$@"
  else
    echo "neither 'docker compose' nor 'docker-compose' found - install Docker Compose" >&2; exit 1
  fi
}
dexec() { # dexec <container> <cmd...>   (interactive TTY when run from a terminal)
  if [ -t 0 ] && [ -t 1 ]; then docker exec -it "$@"; else docker exec -i "$@"; fi
}
# container with the gateway/sgproxy binary (bans): full gateway or the slim proxy
admin_container() {
  if running securegate-gateway; then echo "securegate-gateway gateway"
  elif running securegate-proxy; then echo "securegate-proxy sgproxy"
  else echo "neither securegate-gateway nor securegate-proxy is running" >&2; exit 1; fi
}

is_uplink() { case "$(env_val WG_MODE | tr 'A-Z' 'a-z')" in uplink|client) return 0;; esac; return 1; }
is_relay() { case "$(env_val WG_UPLINK_RELAY | tr 'A-Z' 'a-z')" in 1|true|yes|on) return 0;; esac; return 1; }
relay_port() { # WG_UPLINK_RELAY_PORT, default: the main's port = Endpoint port in data/wireguard/uplink.conf
  local p; p=$(env_val WG_UPLINK_RELAY_PORT)
  [ -n "$p" ] || p=$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=.*:\([0-9][0-9]*\)[[:space:]]*$/\1/Ip' data/wireguard/uplink.conf 2>/dev/null | head -n1)
  echo "${p:-51820}"
}

# WG_MODE=uplink: this server is a WireGuard client of the main server (telemt -> tunnel -> main)
wg_uplink() {
  local f=data/wireguard/uplink.conf iface
  iface=$(env_val WG_UPLINK_IFACE); iface=${iface:-sgup0}
  case "${1:-status}" in
    import)
      local src=${2:?usage: ./sgctl wg uplink import <file.conf>   (made on the main: ./sgctl wg conf <name> --via <main IP>)}
      [ -f "$src" ] || { echo "no such file: $src"; exit 1; }
      grep -qi '^[[:space:]]*PrivateKey' "$src" && grep -qi '^[[:space:]]*Endpoint' "$src" ||
        { echo "$src is not a WireGuard client config (needs PrivateKey and Endpoint)"; exit 1; }
      mkdir -p data/wireguard
      install -m 600 "$src" "$f"
      echo "installed $f"
      is_uplink || echo "NOTE: set WG_MODE=uplink in .env, then: ./sgctl compose up -d wireguard"
      if running securegate-wireguard; then docker restart securegate-wireguard >/dev/null && echo "wireguard container restarted"; fi
      ;;
    status)
      running securegate-wireguard || { echo "wireguard container is not running"; exit 1; }
      is_uplink || echo "NOTE: WG_MODE is not 'uplink' in .env"
      docker exec securegate-wireguard sh -c "wg show $iface 2>/dev/null || echo 'interface $iface is not up'; echo; echo '# policy routing (only this source address goes into the tunnel):'; ip rule show | grep -E 'lookup ${WG_UPLINK_TABLE:-51821}' ; ip route show table ${WG_UPLINK_TABLE:-51821}"
      if is_relay; then
        echo; echo "# relay of WireGuard clients (WG_UPLINK_RELAY=true): udp/$(relay_port) on this host -> main"
        docker exec securegate-wireguard sh -c 'iptables -t nat -S PREROUTING; iptables -S FORWARD' | grep securegate-uplink-relay || echo 'relay rules are NOT installed (see: docker logs securegate-wireguard | grep relay)'
      else
        echo; echo "# relay of WireGuard clients: off (WG_UPLINK_RELAY=true in .env to accept clients of the main here)"
      fi
      echo; docker logs --tail 200 securegate-wireguard 2>&1 | grep 'wireguard-uplink' | tail -n 6
      ;;
    *) echo "usage: ./sgctl wg uplink [status | import <file.conf>]"; exit 2 ;;
  esac
}

need_main() {
  if is_uplink; then
    echo "WG_MODE=uplink: this server is a WireGuard CLIENT of the main server; clients are created there."
    echo "Tunnel status: ./sgctl wg uplink      install config: ./sgctl wg uplink import <file.conf>"
    if is_relay; then
      echo "Client configs that connect through this proxy (WG_UPLINK_RELAY=true, udp/$(relay_port)) - on the MAIN:"
      echo "  ./sgctl wg add <name> --via $(env_val DOMAIN)      (or WG_ENDPOINT=$(env_val DOMAIN) in the main's .env)"
    else
      echo "To accept WireGuard clients of the main here: WG_UPLINK_RELAY=true in .env + ./sgctl compose up -d wireguard"
    fi
    exit 1
  fi
  if is_proxy; then
    echo "This server runs in PROXY mode: WireGuard clients are created on the MAIN server ($(env_val DOMAIN_TO_PROXY))."
    echo "There:  ./sgctl wg add <name> --via $(env_val DOMAIN)     (config that connects through this proxy)"
    exit 1
  fi
  if ! running securegate-wireguard; then
    echo "The wireguard container is not running:  ./sgctl up   (logs: ./sgctl logs wireguard)"
    exit 1
  fi
}

cmd=${1:-help}; [ $# -gt 0 ] && shift
case "$cmd" in
  wg|wireguard)
    if [ "${1:-}" = uplink ]; then shift; wg_uplink "$@"; exit 0; fi
    need_main
    dexec securegate-wireguard wgctl "$@"
    ;;
  mtproxy|mt)
    f=data/mtproxy-links.txt
    [ -f "$f" ] || { echo "no links yet ($f) - is MTProxy enabled and the gateway running?"; exit 1; }
    if [ "${1:-}" = qr ]; then
      user=${2:?usage: ./sgctl mtproxy qr <user> [impl] [host]}; impl=${3:-telemt}; host=${4:-}
      line=$(grep -E "^$user \[$impl\] \(${host:-[^:]+}:" "$f" | head -n1 || true)
      [ -n "$line" ] || { echo "no link for user=$user impl=$impl ${host:+host=$host}"; exit 1; }
      url=${line##*: }
      echo "$line"
      if running securegate-wireguard; then
        docker exec securegate-wireguard qrencode -t ansiutf8 -m 2 "$url"
      elif command -v qrencode >/dev/null; then
        qrencode -t ansiutf8 -m 2 "$url"
      else
        echo "(install qrencode for a QR code: apt install qrencode)"
      fi
    elif [ -n "${1:-}" ]; then
      grep -E "^$1 " "$f" || { echo "no links for user $1"; exit 1; }
    else
      cat "$f"
    fi
    ;;
  vpn)
    # Masquerading-VPN users. Secrets live in ./data/maskvpn/users/<name>.secret (same volume the
    # gateway reads, reloaded within ~15 s, so no restart). QR/config is for the Android app.
    sub=${1:-}; [ $# -gt 0 ] && shift
    if is_proxy; then
      echo "This server runs in PROXY mode: VPN users are created on the MAIN server ($(env_val DOMAIN_TO_PROXY))."
      echo "There:  ./sgctl vpn add <name> --via $(env_val DOMAIN)     (config that connects through this proxy)"
      exit 1
    fi
    udir=data/maskvpn/users
    vname=""; via=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --via) via=${2:?--via needs a host}; shift 2 ;;
        *) vname=$1; shift ;;
      esac
    done
    valid_name() { echo "$1" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; }
    vpn_json() { # $1=name $2=secret -> JSON config
      local host port
      host=${via:-$(env_val DOMAIN)}
      port=$(env_val HTTPS_PORT); port=${port:-443}
      printf '{"v":1,"name":"%s","host":"%s","port":%s,"path":"/app/events","sni":"%s","secret":"%s","transport":"tcp-https"}' \
        "$1" "$host" "$port" "$host" "$2"
    }
    vpn_uri() { # $1=name $2=secret -> sgvpn:// URI (base64url of the JSON)
      printf 'sgvpn://%s' "$(vpn_json "$1" "$2" | base64 -w0 2>/dev/null | tr '+/' '-_' | tr -d '=')"
    }
    show_qr() { # $1=uri
      if running securegate-wireguard; then docker exec securegate-wireguard qrencode -t ansiutf8 -m 2 "$1"
      elif command -v qrencode >/dev/null; then qrencode -t ansiutf8 -m 2 "$1"
      else echo "(install qrencode for a QR code: apt install qrencode)"; fi
    }
    case "$sub" in
      add)
        valid_name "$vname" || { echo "usage: ./sgctl vpn add <name> [--via <host>]  (name: A-Za-z0-9._-)"; exit 1; }
        case "$(env_val VPN_ENABLE | tr 'A-Z' 'a-z')" in 1|true|yes|on) : ;;
          *) echo "VPN is disabled. Set VPN_ENABLE=true in .env and run ./sgctl up, then add users." >&2; exit 1;; esac
        mkdir -p "$udir"; ( umask 077; [ -s "$udir/$vname.secret" ] || openssl rand -hex 16 > "$udir/$vname.secret" )
        echo "VPN user '$vname' ready (reloaded by the gateway within ~15 s)."
        sub=show
        ;;
    esac
    case "$sub" in
      show|conf)
        valid_name "$vname" || { echo "usage: ./sgctl vpn $sub <name> [--via <host>]"; exit 1; }
        [ -s "$udir/$vname.secret" ] || { echo "no such VPN user: $vname  (./sgctl vpn list)"; exit 1; }
        secret=$(tr -d '[:space:]' < "$udir/$vname.secret")
        if [ "$sub" = conf ]; then vpn_json "$vname" "$secret"; echo; else
          uri=$(vpn_uri "$vname" "$secret")
          echo "$uri"; echo
          show_qr "$uri"
          echo
          echo "Scan in the app (Add tunnel -> Scan QR), or save the line above as $vname.sgvpn and import it."
          [ -n "$via" ] || echo "Through a proxy:  ./sgctl vpn show $vname --via <proxy-domain>"
        fi
        ;;
      list)
        if [ -d "$udir" ] && ls "$udir"/*.secret >/dev/null 2>&1; then
          for f in "$udir"/*.secret; do n=$(basename "$f" .secret); echo "$n"; done
        else echo "no VPN users yet:  ./sgctl vpn add <name>"; fi
        ;;
      remove|rm|delete)
        valid_name "$vname" || { echo "usage: ./sgctl vpn remove <name>"; exit 1; }
        if [ -e "$udir/$vname.secret" ]; then rm -f "$udir/$vname.secret"; echo "removed VPN user '$vname' (access revoked within ~15 s)";
        else echo "no such VPN user: $vname"; exit 1; fi
        ;;
      *) echo "usage: ./sgctl vpn add|show|conf|list|remove <name> [--via <host>]"; exit 2 ;;
    esac
    ;;
  bans)
    # shellcheck disable=SC2046
    docker exec $(admin_container) bans
    ;;
  unban)
    ip=${1:?usage: ./sgctl unban <ip|all>}
    # shellcheck disable=SC2046
    docker exec $(admin_container) unban "$ip"
    ;;
  status)
    docker ps -a --filter name=securegate --format 'table {{.Names}}\t{{.Status}}'
    echo
    ss -lntup 2>/dev/null | grep -E 'gateway|sgproxy|telemt|python|teleproxy|:(80|443|3478|51820|2053|2083) ' || true
    ip -br link show "$(env_val WG_INTERFACE || true)" 2>/dev/null || ip -br link show sgwg0 2>/dev/null || true
    ;;
  up)       compose up -d --build "$@" ;;
  build)    compose build "$@" ;;
  ps)       compose ps "$@" ;;
  logs)     compose logs --tail "${SGCTL_TAIL:-100}" -f "$@" ;;
  restart)  compose restart "$@" ;;
  down)     compose down "$@" ;;
  compose|dc) compose "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
