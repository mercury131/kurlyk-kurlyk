# ============================================================================
#  securegate settings. Copy to .env and edit:   cp .env.example .env
#  Values with special characters ($ ` " or spaces) -> wrap in SINGLE quotes.
# ============================================================================

# ---- Domain & TLS ----------------------------------------------------------
# Domain pointing (A record) to this server's public IP. Ports 80 and 443 must be open.
DOMAIN=vpn.example.com
# E-mail for Let's Encrypt notifications
ACME_EMAIL=admin@example.com
# auto        = Let's Encrypt, temporary self-signed cert while LE is not issued yet (default)
# letsencrypt = Let's Encrypt only
# selfsigned  = self-signed only (testing without a public domain)
TLS_MODE=auto
# true = use the Let's Encrypt staging CA (for testing, avoids rate limits)
ACME_STAGING=false
# lenient = allow TLS clients that send no SNI; strict = drop them (stronger anti-scan)
SNI_POLICY=lenient

# ---- SSTP VPN --------------------------------------------------------------
SSTP_ENABLE=true
# user:password pairs separated by commas (password must not contain a comma;
# otherwise put users into config/users.yml)
SSTP_USERS='keenetic:CHANGE_ME_strong_password'
SSTP_LOCAL_IP=192.168.17.1
SSTP_POOL=192.168.17.0/24
SSTP_DNS=8.8.8.8,8.8.4.4
SSTP_MTU=1400
# NAT VPN clients to the internet (MASQUERADE)
SSTP_NAT=true

# ---- MTProxy (telemt, FakeTLS / ee-secrets on port 443) --------------------
MTPROXY_ENABLE=true
# name:32_hex_secret pairs, comma separated. Generate a secret:  openssl rand -hex 16
# (or use config/users.yml -> mtproxy_users). Links are printed in the gateway log
# and saved to data/mtproxy-links.txt
MTPROXY_USERS=alice:00112233445566778899aabbccddeeff
# optional advertising tag from @MTProxybot
MTPROXY_AD_TAG=
MTPROXY_INTERNAL_PORT=8443

# ---- Chat server -----------------------------------------------------------
CHAT_ENABLE=true
# Shared secret key that users enter in the Android app (min 16 chars).
# Both the auth key and the message encryption key are derived from it.
# Generate:  openssl rand -base64 24
CHAT_SECRET='change-me-to-a-long-random-secret'
CHAT_MAX_USERS=100
# Optional whitelist of phone numbers allowed to register (comma separated, E.164)
CHAT_ALLOWED_PHONES=
CHAT_MAX_FILE_MB=100
CHAT_FILES_MAX_GB=10
CHAT_FILE_TTL_HOURS=168
CHAT_QUEUE_TTL_HOURS=720

# ---- TURN (WebRTC calls) ---------------------------------------------------
TURN_ENABLE=true
# Public IP of the server (auto: DNS of DOMAIN, then interface address)
PUBLIC_IP=
# Open these UDP ports in your firewall for best call quality
# (calls also work via TURN-over-TLS on 443 when UDP is blocked).
TURN_UDP_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ---- Protection ------------------------------------------------------------
GUARD_MAX_CONN_PER_IP=40
GUARD_RATE_PER_MIN=120
# penalty points before ban (within 10 minutes)
GUARD_STRIKES=5
# first ban duration; repeated bans double up to 24h
GUARD_BAN_MINUTES=60
# never-banned IPs/CIDRs, comma separated (e.g. your office)
GUARD_WHITELIST=
# also drop banned IPs in the kernel (nftables)
GUARD_NFTABLES=true

LOG_LEVEL=info
