# ============================================================================
#  securegate settings. Copy to .env and edit:   cp .env.example .env
#  Values with special characters ($ ` " or spaces) -> wrap in SINGLE quotes.
# ============================================================================

# ---- Proxy mode -------------------------------------------------------------
# PROXY=true turns this server into a relay (second entry point) in front of your MAIN
# securegate server. Everything (SSTP, MTProxy x3, WireGuard, chat, calls, website) then works
# through this server's own domain. Only DOMAIN, DOMAIN_TO_PROXY, the GUARD_* limits and the
# public ports (MTPROTOPROXY_PORT, TELEPROXY_PORT, WG_PORT, TURN_UDP_PORT - keep them equal to the
# main server's, defaults are fine) are used - all other settings are ignored on a proxy.
#   On the proxy:        PROXY=true, DOMAIN=<proxy domain>, DOMAIN_TO_PROXY=<main domain>
#   On the MAIN server:  PROXY_FRONTENDS=<proxy domain>[,<2nd proxy domain>...]  (+ docker compose up -d)
# The Let's Encrypt certificate for the proxy domain is obtained and renewed by the MAIN
# server automatically (the ACME check comes to the proxy's port 80/443 and is relayed).
PROXY=false
# domain (or IP) of the MAIN securegate server, optionally host:port of its HTTPS port
DOMAIN_TO_PROXY=
# also relay STUN/TURN UDP (TURN_UDP_PORT) for better call quality
PROXY_UDP=true

# ---- Proxy instances relaying to THIS (main) server -------------------------
# Domains of your proxy servers, any number, comma separated:
#   PROXY_FRONTENDS=px1.example.com,px2.example.org,px3.example.net
# For each one this server accepts the domain, obtains a Let's Encrypt certificate for it and
# trusts the PROXY header (real client IP) from the IP addresses the domain resolves to
# (re-resolved every 5 min, each domain separately). An IP address in this list = a proxy
# without a domain (only its IP is trusted).
PROXY_FRONTENDS=
# Optional: proxy source IPs/CIDRs, comma separated, if proxies connect from addresses that
# differ from their DNS A records (e.g. separate outgoing IP):  203.0.113.7,198.51.100.0/28
PROXY_TRUSTED_IPS=

# ---- Domain & TLS ----------------------------------------------------------
# Domain pointing (A record) to this server's public IP. Ports 80 and 443 must be open.
DOMAIN=vpn.example.com
# E-mail for Let's Encrypt notifications
ACME_EMAIL=admin@example.com
# auto        = Let's Encrypt, temporary self-signed cert while LE is not issued yet (default)
# letsencrypt = Let's Encrypt only
# selfsigned  = self-signed only (testing without a public domain)
TLS_MODE=auto
# true = use the Let's Encrypt staging CA (for testing, avoids rate limits)
ACME_STAGING=false
# lenient = allow TLS clients that send no SNI; strict = drop them (stronger anti-scan)
SNI_POLICY=lenient

# ---- SSTP VPN --------------------------------------------------------------
SSTP_ENABLE=true
# user:password pairs separated by commas (password must not contain a comma;
# otherwise put users into config/users.yml)
SSTP_USERS='keenetic:CHANGE_ME_strong_password'
SSTP_LOCAL_IP=192.168.17.1
SSTP_POOL=192.168.17.0/24
SSTP_DNS=8.8.8.8,8.8.4.4
SSTP_MTU=1400
# NAT VPN clients to the internet (MASQUERADE)
SSTP_NAT=true

# ---- MTProxy (telemt, FakeTLS / ee-secrets on port 443) --------------------
MTPROXY_ENABLE=true
# name:32_hex_secret pairs, comma separated. Generate a secret:  openssl rand -hex 16
# (or use config/users.yml -> mtproxy_users). Links are printed in the gateway log
# and saved to data/mtproxy-links.txt
MTPROXY_USERS=alice:00112233445566778899aabbccddeeff
# optional advertising tag from @MTProxybot
MTPROXY_AD_TAG=
MTPROXY_INTERNAL_PORT=8443

# Two more MTProxy implementations on their own ports, with the SAME users (MTPROXY_USERS /
# mtproxy_users above - set once). If one stops working for your clients, use another one:
# links for every implementation and domain are in data/mtproxy-links.txt (./sgctl mtproxy).
# Like 443, these ports show the website to everybody except Telegram clients with a valid secret.
# Port 0 or *_ENABLE=false = off. Open the ports in the firewall.
#   mtprotoproxy - Python, github.com/alexbers/mtprotoproxy
MTPROTOPROXY_ENABLE=true
MTPROTOPROXY_PORT=2053
MTPROTOPROXY_INTERNAL_PORT=8444
#   teleproxy - C, github.com/teleproxy/teleproxy (maintained fork of the official MTProxy)
TELEPROXY_ENABLE=true
TELEPROXY_PORT=2083
TELEPROXY_INTERNAL_PORT=8445

# ---- WireGuard VPN ---------------------------------------------------------
# Clients: ./sgctl wg add <name>  (prints the config + QR code for the WireGuard app),
#          ./sgctl wg list | show <name> | remove <name>
# Keys and clients are stored in data/wireguard/ (survive container re-creation, back it up).
# Open WG_PORT/udp in the firewall. On a proxy server (PROXY=true) WG_PORT/udp is relayed to the
# main server: there use  ./sgctl wg add <name> --via <proxy domain>.
WG_ENABLE=true
WG_PORT=51820
# address pool of the clients (server = first address)
WG_SUBNET=10.17.0.0/24
# DNS for clients (default: SSTP_DNS)
WG_DNS=8.8.8.8,8.8.4.4
WG_MTU=1420
# what clients send through the tunnel: 0.0.0.0/0 = all IPv4 traffic
WG_ALLOWED_IPS=0.0.0.0/0
WG_KEEPALIVE=25
# endpoint host written to client configs (default: DOMAIN)
WG_ENDPOINT=

# ---- Chat server -----------------------------------------------------------
CHAT_ENABLE=true
# Shared secret key that users enter in the Android app (min 16 chars).
# Both the auth key and the message encryption key are derived from it.
# Generate:  openssl rand -base64 24
CHAT_SECRET='change-me-to-a-long-random-secret'
CHAT_MAX_USERS=100
# Optional whitelist of phone numbers allowed to register (comma separated, E.164)
CHAT_ALLOWED_PHONES=
CHAT_MAX_FILE_MB=100
CHAT_FILES_MAX_GB=10
CHAT_FILE_TTL_HOURS=168
CHAT_QUEUE_TTL_HOURS=720

# ---- TURN (WebRTC calls) ---------------------------------------------------
TURN_ENABLE=true
# Public IP of the server (auto: DNS of DOMAIN, then interface address)
PUBLIC_IP=
# Open these UDP ports in your firewall for best call quality
# (calls also work via TURN-over-TLS on 443 when UDP is blocked).
TURN_UDP_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ---- Protection ------------------------------------------------------------
GUARD_MAX_CONN_PER_IP=40
GUARD_RATE_PER_MIN=120
# penalty points before ban (within 10 minutes)
GUARD_STRIKES=5
# first ban duration; repeated bans double up to 24h
GUARD_BAN_MINUTES=60
# never-banned IPs/CIDRs, comma separated (e.g. your office)
GUARD_WHITELIST=
# also drop banned IPs in the kernel (nftables)
GUARD_NFTABLES=true

LOG_LEVEL=info
